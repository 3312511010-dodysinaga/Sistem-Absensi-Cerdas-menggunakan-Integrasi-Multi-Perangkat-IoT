}


// ============================================================
// CEK FINGERPRINT UNTUK ABSENSI
// ============================================================

void cekFingerprintAbsensi() {

  uint8_t p =
    finger.getImage();


  if (
    p != FINGERPRINT_OK
  ) {

    return;
  }


  // ==========================================================
  // KONVERSI
  // ==========================================================

  p =
    finger.image2Tz();


  if (
    p != FINGERPRINT_OK
  ) {

    return;
  }


  // ==========================================================
  // CARI
  // ==========================================================

  p =
    finger.fingerSearch();


  if (
    p == FINGERPRINT_OK
  ) {

    int fingerprintID =
      finger.fingerID;


    int confidence =
      finger.confidence;


    Serial.println();
    Serial.println(
      "=========================="
    );

    Serial.print(
      "ABSENSI FINGER ID: "
    );

    Serial.println(
      fingerprintID
    );

    Serial.print(
      "Confidence: "
    );

    Serial.println(
      confidence
    );

    Serial.println(
      "=========================="
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("FINGER DITEMUKAN");

    lcd.setCursor(0, 1);
    lcd.print("ID: ");

    lcd.print(
      fingerprintID
    );


    delay(800);


    // ========================================================
    // KIRIM ABSENSI
    // ========================================================

    kirimAbsensi(
      fingerprintID
    );


    // ========================================================
    // TUNGGU JARI
    // ========================================================

    tungguJariLepas();


    standbyDisplay();
  }
}


// ============================================================
// KIRIM ABSENSI
// ============================================================

void kirimAbsensi(
  int fingerprintID
) {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("WIFI TERPUTUS");

    lcd.setCursor(0, 1);
    lcd.print("Absensi gagal");


    delay(2000);

    return;
  }


  HTTPClient http;

  http.begin(
    API_ABSENSI
  );

  http.setTimeout(5000);


  http.addHeader(
    "Content-Type",
    "application/x-www-form-urlencoded"
  );


  String data =
    "fingerprint_id=" +
    String(fingerprintID);


  int httpCode =
    http.POST(data);


  Serial.println();
  Serial.println(
    "ABSENSI SERVER"
  );


  Serial.print(
    "HTTP: "
  );

  Serial.println(
    httpCode
  );


  if (
    httpCode == 200
  ) {

    String response =
      http.getString();


    Serial.println(
      response
    );


    prosesResponseAbsensi(
      response
    );

  } else {

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("SERVER ERROR");

    lcd.setCursor(0, 1);
    lcd.print("Coba lagi");


    delay(2000);
  }


  http.end();
}


// ============================================================
// RESPONSE ABSENSI
// ============================================================

void prosesResponseAbsensi(
  String response
) {

  response.trim();


  Serial.print(
    "Response: "
  );

  Serial.println(
    response
  );


  // ==========================================================
  // TAP IN / TAP OUT
  // ==========================================================

  if (
    response.startsWith("OK|")
  ) {

    int p1 =
      response.indexOf('|');


    int p2 =
      response.indexOf(
        '|',
        p1 + 1
      );


    int p3 =
      response.indexOf(
        '|',
        p2 + 1
      );


    if (
      p1 < 0 ||
      p2 < 0 ||
      p3 < 0
    ) {

      tampilkanServerError();

      return;
    }


    String tipe =
      response.substring(
        p1 + 1,
        p2
      );


    String nama =
      response.substring(
        p2 + 1,
        p3
      );


    String jam =
      response.substring(
        p3 + 1
      );


    // ========================================================
    // TAP IN
    // ========================================================

    if (
      tipe == "TAP_IN"
    ) {

      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("TAP IN BERHASIL");

      lcd.setCursor(0, 1);


      if (
        nama.length() > 16
      ) {

        lcd.print(
          nama.substring(
            0,
            16
          )
        );

      } else {

        lcd.print(
          nama
        );
      }


      delay(2500);


      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("MASUK");

      lcd.setCursor(0, 1);
      lcd.print(jam);


      delay(2000);
    }


    // ========================================================
    // TAP OUT
    // ========================================================

    else if (
      tipe == "TAP_OUT"
    ) {

      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("TAP OUT BERHASIL");

      lcd.setCursor(0, 1);


      if (
        nama.length() > 16
      ) {

        lcd.print(
          nama.substring(
            0,
            16
          )
        );

      } else {

        lcd.print(
          nama
        );
      }


      delay(2500);


      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("PULANG");

      lcd.setCursor(0, 1);
      lcd.print(jam);


      delay(2000);
    }


    return;
  }


  // ==========================================================
  // ERROR
  // ==========================================================

  if (
    response.indexOf(
      "FINGERPRINT_TIDAK_TERDAFTAR"
    ) >= 0
  ) {

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("FINGERPRINT");

    lcd.setCursor(0, 1);
    lcd.print("TIDAK TERDAFTAR");


    delay(2500);

    return;
  }


  if (
    response.indexOf(
      "SUDAH_TAP_IN_OUT"
    ) >= 0
  ) {

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("SUDAH ABSEN");

    lcd.setCursor(0, 1);
    lcd.print("HARI INI");


    delay(2500);

    return;
  }


  tampilkanServerError();
}


