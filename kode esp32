    Serial.println(
      "Fingerprint berhasil dihapus"
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("FINGER DIHAPUS");

    lcd.setCursor(0, 1);
    lcd.print("ID: ");

    lcd.print(
      fingerprintID
    );


    kirimResult(
      commandID,
      pegawaiID,
      fingerprintID,
      "SUCCESS",
      "Fingerprint berhasil dihapus"
    );

  } else {

    Serial.print(
      "Gagal hapus. Code: "
    );

    Serial.println(
      p
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("GAGAL HAPUS");

    lcd.setCursor(0, 1);
    lcd.print("ID: ");

    lcd.print(
      fingerprintID
    );


    kirimResult(
      commandID,
      pegawaiID,
      fingerprintID,
      "FAILED",
      "Fingerprint gagal dihapus"
    );
  }


  delay(2000);


  processingCommand =
    false;


  standbyDisplay();
}


// ============================================================
// KIRIM RESULT ENROLL / DELETE
// ============================================================

void kirimResult(
  int commandID,
  int pegawaiID,
  int fingerprintID,
  String status,
  String message
) {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    Serial.println(
      "WiFi tidak tersedia"
    );

    return;
  }


  HTTPClient http;

  http.begin(
    API_RESULT
  );

  http.setTimeout(5000);


  http.addHeader(
    "Content-Type",
    "application/x-www-form-urlencoded"
  );


  String data =
    "command_id=" +
    String(commandID) +

    "&pegawai_id=" +
    String(pegawaiID) +

    "&fingerprint_id=" +
    String(fingerprintID) +

    "&status=" +
    status +

    "&message=" +
    urlencode(message);


  Serial.println();
  Serial.println(
    "Kirim hasil command:"
  );

  Serial.println(
    data
  );


  int httpCode =
    http.POST(data);


  Serial.print(
    "HTTP Result: "
  );

  Serial.println(
    httpCode
  );


  if (
    httpCode > 0
  ) {

    String response =
      http.getString();

    Serial.println(
      response
    );
  }


  http.end();
}


// ============================================================
// CEK LOGIN KARYAWAN
// ============================================================

void cekPerintahLogin() {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    return;
  }


  if (
    processingLogin
  ) {

    return;
  }


  HTTPClient http;

  http.begin(
    API_LOGIN_COMMAND
  );

  http.setTimeout(4000);


  int httpCode =
    http.GET();


  Serial.print(
    "LOGIN COMMAND HTTP: "
  );

  Serial.println(
    httpCode
  );


  if (
    httpCode == 200
  ) {

    String response =
      http.getString();


    Serial.println();
    Serial.println(
      "COMMAND LOGIN:"
    );

    Serial.println(
      response
    );


    prosesCommandLogin(
      response
    );

  } else {

    if (httpCode > 0) {

      String response =
        http.getString();

      Serial.println(
        "LOGIN COMMAND RESPONSE:"
      );

      Serial.println(
        response
      );
    }
  }


  http.end();
}


// ============================================================
// PROSES COMMAND LOGIN
// ============================================================

void prosesCommandLogin(
  String json
) {

  DynamicJsonDocument doc(1024);


  DeserializationError error =
    deserializeJson(
      doc,
      json
    );


  if (error) {

    Serial.println(
      "JSON login error"
    );

    return;
  }


  bool success =
    doc["success"] |
    false;


  if (!success) {

    return;
  }


  if (
    doc["command"].isNull()
  ) {

    Serial.println(
      "Belum ada command login"
    );

    return;
  }


  String token =
    doc["command"]["token"] |
    "";


  if (
    token.length() < 10
  ) {

    Serial.println(
      "Token login tidak valid"
    );

    return;
  }


  // ==========================================================
  // PENTING:
  // SET PROCESSING SEBELUM SCAN
  // ==========================================================

  processingLogin = true;

  loginToken =
    token;


  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "LOGIN KARYAWAN DIMINTA"
  );

  Serial.println(
    "================================"
  );

  Serial.print(
    "Token: "
  );

  Serial.println(
    loginToken
  );


  prosesLoginFingerprint();
}


// ============================================================
// SCAN LOGIN
// ============================================================

void prosesLoginFingerprint() {

  // Pastikan status aktif
  processingLogin =
    true;


  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("LOGIN KARYAWAN");

  lcd.setCursor(0, 1);
  lcd.print("Tempelkan Jari");


  Serial.println(
    "Menunggu fingerprint login..."
  );


  // ==========================================================
  // TUNGGU JARI
  // ==========================================================

  uint8_t p =
    tungguJari(
      15000
    );


  if (
    p != FINGERPRINT_OK
  ) {

    Serial.println(
      "Login timeout"
    );


    kirimLoginResult(
      loginToken,
      0
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("LOGIN TIMEOUT");

    lcd.setCursor(0, 1);
    lcd.print("Coba lagi");


    delay(2000);


    // PASTIKAN RESET
    processingLogin =
      false;

    loginToken = "";

    // Reset timer polling
    lastLoginCheck = millis();

    standbyDisplay();

    return;
  }


  // ==========================================================
  // KONVERSI
  // ==========================================================

  Serial.println(
    "Mengubah gambar fingerprint..."
  );


  p =
    finger.image2Tz();


  if (
    p != FINGERPRINT_OK
  ) {

    gagalLogin(
      "Gagal membaca fingerprint"
    );

    return;
  }


  // ==========================================================
  // CARI FINGERPRINT
  // ==========================================================

  Serial.println(
    "Mencari fingerprint di sensor..."
  );


  p =
    finger.fingerFastSearch();


  // ==========================================================
  // TIDAK DITEMUKAN
  // ==========================================================

  if (
    p != FINGERPRINT_OK
  ) {

    Serial.print(
      "Fingerprint tidak ditemukan. Code: "
    );

    Serial.println(
      p
    );


    kirimLoginResult(
      loginToken,
      0
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("FINGER TIDAK");

    lcd.setCursor(0, 1);
    lcd.print("TERDAFTAR");


    delay(2000);


    // Sangat penting:
    // pastikan jari dilepas
    tungguJariLepas();


    processingLogin =
      false;

    loginToken = "";

    lastLoginCheck = millis();


    standbyDisplay();

    return;
  }


  // ==========================================================
  // AMBIL ID HASIL PENCARIAN SENSOR
  // ==========================================================

  int fingerprintID =
    finger.fingerID;


  int confidence =
    finger.confidence;


  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "FINGERPRINT LOGIN DITEMUKAN"
  );

  Serial.println(
    "================================"
  );

  Serial.print(
    "Fingerprint ID : "
  );

  Serial.println(
    fingerprintID
  );

  Serial.print(
    "Confidence     : "
  );

  Serial.println(
    confidence
  );

  Serial.println(
    "================================"
  );


  // ==========================================================
  // KIRIM KE SERVER
  // ==========================================================

  bool serverOK =
    kirimLoginResult(
      loginToken,
      fingerprintID
    );


  // ==========================================================
  // TAMPILAN LCD
  // ==========================================================

  lcd.clear();


  if (serverOK) {

    lcd.setCursor(0, 0);
    lcd.print("LOGIN BERHASIL");

    lcd.setCursor(0, 1);
    lcd.print("ID: ");

    lcd.print(
      fingerprintID
    );

  } else {

    lcd.setCursor(0, 0);
    lcd.print("LOGIN GAGAL");

    lcd.setCursor(0, 1);
    lcd.print("Tidak terdaftar");
  }


  delay(2000);


  // ==========================================================
  // WAJIB LEPAS JARI
  // ==========================================================

  Serial.println(
    "Menunggu jari dilepas..."
  );

  tungguJariLepas();


  // ==========================================================
  // RESET TOTAL LOGIN
  // ==========================================================

  processingLogin =
    false;

  loginToken = "";

  // Jangan langsung menggunakan request lama
  lastLoginCheck = millis();


  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "LOGIN SELESAI"
  );

  Serial.println(
    "ESP32 KEMBALI MENUNGGU LOGIN BARU"
  );

  Serial.println(
    "================================"
  );


  standbyDisplay();
}


// ============================================================
// KIRIM LOGIN RESULT
// ============================================================

bool kirimLoginResult(
  String token,
  int fingerprintID
) {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    Serial.println(
      "WiFi tidak tersedia"
    );

    return false;
  }


  HTTPClient http;

  http.begin(
    API_LOGIN_RESULT
  );

  http.setTimeout(5000);


  http.addHeader(
    "Content-Type",
    "application/x-www-form-urlencoded"
  );


  String data =
    "token=" +
    urlencode(token) +

    "&fingerprint_id=" +
    String(fingerprintID);


  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "KIRIM LOGIN KE SERVER"
  );

  Serial.println(
    "================================"
  );

  Serial.print(
    "Fingerprint ID : "
  );

  Serial.println(
    fingerprintID
  );


  int httpCode =
    http.POST(data);


  Serial.print(
    "HTTP Code      : "
  );

  Serial.println(
    httpCode
  );


  if (
    httpCode <= 0
  ) {

    Serial.print(
      "HTTP Error     : "
    );

    Serial.println(
      http.errorToString(
        httpCode
      )
    );


    http.end();

    return false;
  }


  String response =
    http.getString();


  Serial.print(
    "Server Response: "
  );

  Serial.println(
    response
  );


  http.end();


  // ==========================================================
  // PARSE RESPONSE
  // ==========================================================

  DynamicJsonDocument doc(1024);


  DeserializationError error =
    deserializeJson(
      doc,
      response
    );


  if (error) {

    Serial.println(
      "Response bukan JSON"
    );

    return false;
  }


  bool success =
    doc["success"] |
    false;


  if (success) {

    String nama =
      doc["nama"] |
      "";


    int pegawaiID =
      doc["pegawai_id"] |
      0;


    Serial.println();
    Serial.println(
      "LOGIN BERHASIL"
    );


    Serial.print(
      "Nama          : "
    );

    Serial.println(
      nama
    );


    Serial.print(
      "Pegawai ID    : "
    );

    Serial.println(
      pegawaiID
    );


    Serial.print(
      "Fingerprint ID: "
    );

    Serial.println(
      fingerprintID
    );


    return true;
  }


  String message =
    doc["message"] |
    "Login gagal";


  Serial.print(
    "LOGIN DITOLAK: "
  );

  Serial.println(
    message
  );


  return false;
}


