  Serial.println();
  Serial.println(
    "===== HAPUS FINGER ====="
  );


  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("HAPUS FINGER");

  lcd.setCursor(0, 1);
  lcd.print("ID: ");

  lcd.print(
