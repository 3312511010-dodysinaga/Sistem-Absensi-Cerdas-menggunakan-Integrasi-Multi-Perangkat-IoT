/*
============================================================
        SISTEM ABSENSI FINGERPRINT ESP32
============================================================

FITUR:
1. Daftar Fingerprint dari Admin
2. Hapus Fingerprint dari Admin
3. Login Karyawan menggunakan Fingerprint
4. Tap In
5. Tap Out
6. LCD 16x2
7. WiFi
8. PHP + MySQL / XAMPP

KONSEP FINGERPRINT ID:
- ID ditentukan MANUAL oleh Admin
- Tidak ada auto ID
- Contoh:
    Budi   -> ID 5
    Andi   -> ID 8
    Candra -> ID 12

PIN FINGERPRINT:
Sensor TX -> ESP32 GPIO16
Sensor RX -> ESP32 GPIO17

PIN LCD:
SDA -> GPIO21
SCL -> GPIO22

============================================================
*/

#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Adafruit_Fingerprint.h>


// ============================================================
// CONFIGURATION
// ============================================================

// WIFI
const char* WIFI_SSID     = "IOT BANGET";
const char* WIFI_PASSWORD = "PINTAR12345";


// IP KOMPUTER YANG MENJALANKAN XAMPP
const char* SERVER_IP = "10.186.233.224";


// ============================================================
// API SERVER
// ============================================================

String API_COMMAND =
  "http://" + String(SERVER_IP) +
  "/absensi/api/fingerprint_command.php";

String API_RESULT =
  "http://" + String(SERVER_IP) +
  "/absensi/api/fingerprint_result.php";

String API_ABSENSI =
  "http://" + String(SERVER_IP) +
  "/absensi/api/fingerprint.php";


// LOGIN KARYAWAN

String API_LOGIN_COMMAND =
  "http://" + String(SERVER_IP) +
  "/absensi/api/fingerprint_login_command.php";

String API_LOGIN_RESULT =
  "http://" + String(SERVER_IP) +
  "/absensi/api/fingerprint_login_result.php";


// ============================================================
// LCD
// ============================================================

LiquidCrystal_I2C lcd(0x27, 16, 2);


// ============================================================
// FINGERPRINT
// ============================================================

HardwareSerial FingerSerial(2);

Adafruit_Fingerprint finger =
  Adafruit_Fingerprint(&FingerSerial);


// PIN UART2

#define FINGER_RX 16
#define FINGER_TX 17


// ============================================================
// TIMER
// ============================================================

unsigned long lastCommandCheck = 0;

unsigned long lastLoginCheck = 0;

unsigned long lastFingerprintCheck = 0;

unsigned long lastWiFiCheck = 0;


// Interval

const unsigned long COMMAND_INTERVAL = 1500;

const unsigned long LOGIN_INTERVAL = 1500;

const unsigned long FINGER_INTERVAL = 250;

const unsigned long WIFI_INTERVAL = 5000;


// ============================================================
// STATUS
// ============================================================

bool processingCommand = false;

bool processingLogin = false;


// ============================================================
// LOGIN TOKEN
// ============================================================

String loginToken = "";


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("======================================");
  Serial.println(" SISTEM ABSENSI FINGERPRINT ESP32");
  Serial.println("======================================");


  // ==========================================================
  // LCD
  // ==========================================================

  Wire.begin(21, 22);

  lcd.init();

  lcd.backlight();

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("ABSENSI FINGER");

  lcd.setCursor(0, 1);
  lcd.print("Starting...");

  delay(1500);


  // ==========================================================
  // FINGERPRINT UART
  // ==========================================================

  FingerSerial.begin(
    57600,
    SERIAL_8N1,
    FINGER_RX,
    FINGER_TX
  );

  finger.begin(57600);

  delay(500);


  if (finger.verifyPassword()) {

    Serial.println("Fingerprint sensor OK");

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("FINGERPRINT");

    lcd.setCursor(0, 1);
    lcd.print("SENSOR OK");

    delay(1500);

  } else {

    Serial.println("Fingerprint sensor ERROR");

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("FINGER ERROR");

    lcd.setCursor(0, 1);
    lcd.print("Cek kabel");

    delay(2000);
  }


  // ==========================================================
  // WIFI
  // ==========================================================

  connectWiFi();


  // ==========================================================
  // STANDBY
  // ==========================================================

  standbyDisplay();
}


// ============================================================
// LOOP
// ============================================================

void loop() {


  // ==========================================================
  // CEK WIFI
  // ==========================================================

  if (
    millis() - lastWiFiCheck >=
    WIFI_INTERVAL
  ) {

    lastWiFiCheck = millis();

    if (
      WiFi.status() != WL_CONNECTED
    ) {

      Serial.println(
        "WiFi terputus"
      );

      connectWiFi();

      // Setelah reconnect, beri kesempatan
      // polling login dari awal lagi
      lastLoginCheck = millis();
      lastCommandCheck = millis();
    }
  }


  // ==========================================================
  // JIKA SEDANG PROSES ENROLL / DELETE
  // ==========================================================

  if (!processingCommand &&
      !processingLogin) {

    // --------------------------------------------------------
    // PRIORITAS 1:
    // PERINTAH ADMIN
    // --------------------------------------------------------

    if (
      millis() - lastCommandCheck >=
      COMMAND_INTERVAL
    ) {

      lastCommandCheck = millis();

      cekPerintahAdmin();
    }
  }


  // ==========================================================
  // LOGIN KARYAWAN
  // ==========================================================

  if (!processingCommand &&
      !processingLogin) {

    if (
      millis() - lastLoginCheck >=
      LOGIN_INTERVAL
    ) {

      lastLoginCheck = millis();

      cekPerintahLogin();
    }
  }


  // ==========================================================
  // ABSENSI NORMAL
  // ==========================================================

  if (!processingCommand &&
      !processingLogin) {

    if (
      millis() - lastFingerprintCheck >=
      FINGER_INTERVAL
    ) {

      lastFingerprintCheck =
        millis();

      cekFingerprintAbsensi();
    }
  }
}


// ============================================================
// WIFI
// ============================================================

void connectWiFi() {

  Serial.println();
  Serial.print("Menghubungkan WiFi: ");
  Serial.println(WIFI_SSID);


  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("CONNECTING WIFI");

  lcd.setCursor(0, 1);
  lcd.print("Mohon tunggu...");


  WiFi.mode(WIFI_STA);

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );


  int counter = 0;


  while (
    WiFi.status() != WL_CONNECTED &&
    counter < 30
  ) {

    delay(500);

    Serial.print(".");

    counter++;
  }


  Serial.println();


  if (
    WiFi.status() == WL_CONNECTED
  ) {

    Serial.println("WiFi TERHUBUNG");

    Serial.print("IP ESP32: ");

    Serial.println(
      WiFi.localIP()
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("WIFI CONNECTED");

    lcd.setCursor(0, 1);

    String ip =
      WiFi.localIP().toString();

    lcd.print(
      ip.substring(
        0,
        16
      )
    );


    delay(1500);

  } else {

    Serial.println(
      "WiFi GAGAL"
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("WIFI GAGAL");

    lcd.setCursor(0, 1);
    lcd.print("Cek jaringan");

    delay(1500);
  }
}


// ============================================================
// CEK PERINTAH ADMIN
// ============================================================

void cekPerintahAdmin() {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    return;
  }


  HTTPClient http;

  http.begin(
    API_COMMAND
  );

  http.setTimeout(4000);


  int httpCode =
    http.GET();


  if (httpCode == 200) {

    String response =
      http.getString();


    Serial.println();
    Serial.println(
      "COMMAND ADMIN:"
    );

    Serial.println(
      response
    );


    prosesCommandAdmin(
      response
    );

  } else {

    Serial.print(
      "HTTP Command Error: "
    );

    Serial.println(
      httpCode
    );
  }


  http.end();
}


// ============================================================
// PROSES COMMAND ADMIN
// ============================================================

void prosesCommandAdmin(
  String json
) {

  DynamicJsonDocument doc(1024);


  DeserializationError error =
    deserializeJson(
      doc,
      json
    );


  if (error) {

    Serial.println(
      "JSON command error"
    );

    return;
  }


  bool success =
    doc["success"] |
    false;


  if (!success) {

    return;
  }


  if (
    doc["command"].isNull()
  ) {

    return;
  }


  int commandID =
    doc["command"]["id"];


  String type =
    doc["command"]["type"] |
    "";


  int pegawaiID =
    doc["command"]["pegawai_id"];


  int fingerprintID =
    doc["command"]["fingerprint_id"];


  Serial.println();
  Serial.println(
    "=========================="
  );

  Serial.print(
    "Command ID: "
  );

  Serial.println(
    commandID
  );


  Serial.print(
    "Type: "
  );

  Serial.println(
    type
  );


  Serial.print(
    "Pegawai ID: "
  );

  Serial.println(
    pegawaiID
  );


  Serial.print(
    "Fingerprint ID: "
  );

  Serial.println(
    fingerprintID
  );


  Serial.println(
    "=========================="
  );


  // =========================================================
  // ENROLL
  // =========================================================

  if (
    type == "ENROLL"
  ) {

    prosesEnroll(
      commandID,
      pegawaiID,
      fingerprintID
    );

  }


  // =========================================================
  // DELETE
  // =========================================================

  else if (
    type == "DELETE"
  ) {

    prosesDelete(
      commandID,
      pegawaiID,
      fingerprintID
    );
  }
}


// ============================================================
// ENROLL
// ============================================================

void prosesEnroll(
  int commandID,
  int pegawaiID,
  int fingerprintID
) {

  processingCommand = true;


  Serial.println();
  Serial.println(
    "===== MULAI ENROLL ====="
  );


  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("DAFTAR FINGER");

  lcd.setCursor(0, 1);
  lcd.print("ID: ");

  lcd.print(
    fingerprintID
  );


  delay(1500);


  // ==========================================================
  // CEK ID
  // ==========================================================

  uint8_t p =
    finger.loadModel(
      fingerprintID
    );


  if (
    p == FINGERPRINT_OK
  ) {

    Serial.println(
      "ID sudah digunakan"
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("ID SUDAH ADA");

    lcd.setCursor(0, 1);
    lcd.print("ID: ");

    lcd.print(
      fingerprintID
    );


    kirimResult(
      commandID,
      pegawaiID,
      fingerprintID,
      "FAILED",
      "Fingerprint ID sudah digunakan"
    );


    delay(2000);

    processingCommand =
      false;

    standbyDisplay();

    return;
  }


  // ==========================================================
  // JARI PERTAMA
  // ==========================================================

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("TEMPELKAN JARI");

  lcd.setCursor(0, 1);
  lcd.print("Pertama...");


  Serial.println(
    "Tempelkan jari pertama"
  );


  p =
    tungguJari(
      15000
    );


  if (
    p != FINGERPRINT_OK
  ) {

    gagalEnroll(
      commandID,
      pegawaiID,
      fingerprintID,
      "Timeout jari pertama"
    );

    return;
  }


  // ==========================================================
  // IMAGE 1
  // ==========================================================

  p =
    finger.image2Tz(1);


  if (
    p != FINGERPRINT_OK
  ) {

    gagalEnroll(
      commandID,
      pegawaiID,
      fingerprintID,
      "Gagal membaca jari pertama"
    );

    return;
  }


  // ==========================================================
  // ANGKAT JARI
  // ==========================================================

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("ANGKAT JARI");

  lcd.setCursor(0, 1);
  lcd.print("Tunggu...");


  tungguJariLepas();


  delay(500);


  // ==========================================================
  // JARI KEDUA
  // ==========================================================

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("TEMPELKAN LAGI");

  lcd.setCursor(0, 1);
  lcd.print("Jari yang sama");


  Serial.println(
    "Tempelkan jari kedua"
  );


  p =
    tungguJari(
      15000
    );


  if (
    p != FINGERPRINT_OK
  ) {

    gagalEnroll(
      commandID,
      pegawaiID,
      fingerprintID,
      "Timeout jari kedua"
    );

    return;
  }


  // ==========================================================
  // IMAGE 2
  // ==========================================================

  p =
    finger.image2Tz(2);


  if (
    p != FINGERPRINT_OK
  ) {

    gagalEnroll(
      commandID,
      pegawaiID,
      fingerprintID,
      "Gagal membaca jari kedua"
    );

    return;
  }


  // ==========================================================
  // BUAT MODEL
  // ==========================================================

  p =
    finger.createModel();


  if (
    p != FINGERPRINT_OK
  ) {

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("JARI BERBEDA");

    lcd.setCursor(0, 1);
    lcd.print("Ulangi lagi");


    gagalEnrollServer(
      commandID,
      pegawaiID,
      fingerprintID,
      "Jari pertama dan kedua berbeda"
    );


    delay(2000);

    processingCommand =
      false;

    standbyDisplay();

    return;
  }


  // ==========================================================
  // SIMPAN MODEL
  // ==========================================================

  p =
    finger.storeModel(
      fingerprintID
    );


  if (
    p == FINGERPRINT_OK
  ) {

    Serial.println(
      "Fingerprint tersimpan"
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("BERHASIL!");

    lcd.setCursor(0, 1);
    lcd.print("ID: ");

    lcd.print(
      fingerprintID
    );


    kirimResult(
      commandID,
      pegawaiID,
      fingerprintID,
      "SUCCESS",
      "Fingerprint berhasil didaftarkan"
    );


    delay(2500);

  } else {

    Serial.println(
      "Gagal menyimpan fingerprint"
    );


    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("GAGAL SIMPAN");

    lcd.setCursor(0, 1);
    lcd.print("Fingerprint");


    kirimResult(
      commandID,
      pegawaiID,
      fingerprintID,
      "FAILED",
      "Gagal menyimpan fingerprint"
    );


    delay(2500);
  }


  processingCommand =
    false;


  standbyDisplay();
}


// ============================================================
// TUNGGU JARI
// ============================================================

uint8_t tungguJari(
  unsigned long timeout
) {

  unsigned long start =
    millis();


  while (
    millis() - start <
    timeout
  ) {

    uint8_t p =
      finger.getImage();


    if (
      p == FINGERPRINT_OK
    ) {

      return p;
    }


    delay(100);
  }


  return FINGERPRINT_NOFINGER;
}


// ============================================================
// TUNGGU JARI DILEPAS
// ============================================================

void tungguJariLepas() {

  unsigned long start =
    millis();


  while (
    millis() - start <
    10000
  ) {

    uint8_t p =
      finger.getImage();


    if (
      p == FINGERPRINT_NOFINGER
    ) {

      return;
    }


    delay(100);
  }
}


