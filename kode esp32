// ============================================================
// URL ENCODE
// ============================================================

String urlencode(
  String str
) {

  String encoded = "";

  char c;

  char code0;

  char code1;


  for (
    int i = 0;
    i < str.length();
    i++
  ) {

    c =
      str.charAt(i);


    if (
      (c >= 'a' && c <= 'z') ||
      (c >= 'A' && c <= 'Z') ||
      (c >= '0' && c <= '9') ||
      c == '-' ||
      c == '_' ||
      c == '.' ||
      c == '~'
    ) {

      encoded += c;

    } else {

      encoded += '%';


      code0 =
        (c >> 4) & 0xF;


      code1 =
        c & 0xF;


      encoded +=
        code0 > 9
        ? char('A' + code0 - 10)
        : char('0' + code0);


      encoded +=
        code1 > 9
        ? char('A' + code1 - 10)
        : char('0' + code1);
    }
  }


  return encoded;
}